#!/bin/sh
# {{ ansible_managed }}
# Set the password for the operators' contacts page. Usage: offgrid-dashboard-password [user name]
set -eu
user=${1:-operator}
file={{ offgrid_suite_dashboard_users }}
[ "$(id -u)" = 0 ] || { echo "Run with sudo" >&2; exit 1; }
hash=$(openssl passwd -6)
others=$(grep -v "^$user:" "$file" || true)
{ [ -n "$others" ] && printf '%s\n' "$others"; printf '%s:%s\n' "$user" "$hash"; } > "$file.new"
chown root:www-data "$file.new"
chmod 0640 "$file.new"
mv "$file.new" "$file"
echo "Password set for $user. Open /contacts/ on the host's web page."
