# {{ ansible_managed }}
# Shared files, read only: {{ reticulum_host_http_files_dir }}
server {
    listen {{ reticulum_host_http_port }} default_server;
    listen [::]:{{ reticulum_host_http_port }} default_server;
    server_name _;
    server_tokens off;

    root {{ reticulum_host_http_files_dir }};
    charset utf-8;
    autoindex on;
    autoindex_exact_size off;
    autoindex_localtime on;

    location / {
        # Downloads only
        limit_except GET HEAD { deny all; }
    }
    # No hidden files, such as .git folders
    location ~ /\. { deny all; }
}
