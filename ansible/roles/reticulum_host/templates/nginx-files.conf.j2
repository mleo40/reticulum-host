# {{ ansible_managed }}
# The host's page, written at each boot: {{ reticulum_host_web_dir }}
# Shared files, read only, under /files/: {{ reticulum_host_http_files_dir }}
server {
    listen {{ reticulum_host_http_port }} default_server;
    listen [::]:{{ reticulum_host_http_port }} default_server;
    server_name _;
    server_tokens off;
    charset utf-8;

    root {{ reticulum_host_web_dir }};
    index index.html;

    location / {
        # Downloads only
        limit_except GET HEAD { deny all; }
        # The addresses change on live systems, so always fetch the current page
        add_header Cache-Control no-cache;
        try_files $uri $uri/ =404;
    }
    location /files/ {
        limit_except GET HEAD { deny all; }
        alias {{ reticulum_host_http_files_dir }}/;
        autoindex on;
        autoindex_exact_size off;
        autoindex_localtime on;
    }
    # No hidden files, such as .git folders
    location ~ /\. { deny all; }
}
