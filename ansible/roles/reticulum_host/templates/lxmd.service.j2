# {{ ansible_managed }}
[Unit]
Description=LXMF router and propagation node
After=rnsd.service
Requires=rnsd.service

[Service]
User={{ reticulum_host_user }}
ExecStart={{ reticulum_host_venv }}/bin/lxmd \
  --config {{ reticulum_host_home }}/lxmd \
  --rnsconfig {{ reticulum_host_rns_dir }} \
  --service
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
