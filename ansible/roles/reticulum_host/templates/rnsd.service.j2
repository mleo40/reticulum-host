# {{ ansible_managed }}
[Unit]
Description=Reticulum network stack
After=network-online.target
Wants=network-online.target

[Service]
User={{ reticulum_host_user }}
ExecStart={{ reticulum_host_venv }}/bin/rnsd --config {{ reticulum_host_rns_dir }} --service
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
